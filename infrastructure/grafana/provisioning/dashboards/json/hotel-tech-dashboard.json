      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{datname=\"hotel_db\"}) or sum(pg_stat_database_numbackends)",
          "refId": "A"
