{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Hotel Premium Helm 4 Values Schema",
  "type": "object",
  "required": ["global", "services"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "namespace", "imagePullPolicy"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["dev", "staging", "prod", "production", "minikube", "openshift"]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"]
        },
        "openshift": {
          "type": "boolean"
        }
      }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "route": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "tls": {
              "type": "object",
              "properties": {
                "termination": { "type": "string", "enum": ["edge", "passthrough", "reencrypt"] },
                "insecureEdgeTerminationPolicy": { "type": "string", "enum": ["Redirect", "Allow", "None"] }
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "required": [
        "roomService",
        "stayService",
        "billingService",
        "notificationWorker",
        "hotelFrontend"
      ]
    }
  }
}
