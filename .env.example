# ==============================================================================
# HOTEL PREMIUM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=80

# API Gateway (Kong DB-Less 3.14.0.16)
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Database Configuration (PostgreSQL 18.6)
DB_HOST=postgres
DB_PORT=5432
DB_USER=hotel_admin
DB_PASSWORD=hotel_secure_password_2026
DB_NAME=hotel_premium_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Redis Cache (Redis 8.8.1-alpine)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Identity & Access Management (Keycloak 26.8.1)
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=hotel-realm
KEYCLOAK_CLIENT_ID=hotel-backend
KEYCLOAK_CLIENT_SECRET=hotel_backend_secret_key_2026

# Apache Kafka 7.8.0 (KRaft) & Kafka Exporter v1.9.0
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXPORTER_PORT=9308
KAFKA_STAY_TOPIC=hotel.stays.lifecycle.v1

# HashiCorp Vault 2.0 / KV-v2 Secret Engine & ESO
VAULT_PORT=8200
VAULT_ADDR=http://vault:8200
VAULT_ROOT_TOKEN=hotel_vault_dev_root_token_2026

# Security & JWT Secrets
JWT_SECRET=super_secret_hotel_jwt_key_at_least_32_characters_long_2026
JWT_EXPIRATION_HOURS=24

# Observability Suite (Prometheus, Grafana, Loki, Tempo, Alloy)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=3300
OTEL_COLLECTOR_URL=otel-collector:4317

# Endpoints
VITE_API_BASE_URL=/api
