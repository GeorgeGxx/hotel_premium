      "name": "Hotel Premium Frontend Web SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1",
        "http://localhost:8000",
        "http://localhost:5173"
      ]
    },
    {
      "id": "client-backend-id",
      "clientId": "hotel-backend",
      "name": "Hotel Premium Go Backend API",
      "enabled": true,
      "publicClient": false,
      "secret": "hotel_backend_secret_key_2026",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
