{
  "id": "hotel-realm",
  "realm": "hotel-realm",
  "enabled": true,
  "displayName": "Hotel Premium PMS",
  "displayNameHtml": "<b>Hotel Premium</b> PMS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "id": "role-admin-id",
        "name": "ADMIN",
        "description": "Hotel General Administrator with full access to PMS and management panel",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-manager-id",
        "name": "MANAGER",
        "description": "Hotel Operations Manager with rate, folio, and shift management privileges",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-receptionist-id",
        "name": "RECEPTIONIST",
        "description": "Front Desk Receptionist with permissions to manage check-in, check-out, and reservations",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-housekeeping-id",
        "name": "HOUSEKEEPING",
        "description": "Housekeeping staff with permissions to update room cleaning and maintenance status",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-user-id",
        "name": "USER",
        "description": "Authenticated hotel guest or basic operator",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "USER"
  ],
  "clients": [
    {
      "id": "client-frontend-id",
