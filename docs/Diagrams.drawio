  <diagram id="page_2_vault" name="2. HashiCorp Vault v2.2.0 Zero-Trust Security">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;HASHICORP VAULT v2.2.0 — ZERO-TRUST SECRETS &amp;amp; PKI ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;KV-v2 Secrets • Scoped Kubernetes ServiceAccount Auth • External Secrets Operator (ESO) • Istio Root &amp;amp; Intermediate PKI CA&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="200" y="30" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_cli" parent="1" value="&lt;b&gt;1. Orchestrator Vault Automation&lt;/b&gt;&lt;br&gt;&lt;code&gt;.\platform-minikube.ps1 vault -VaultAction &amp;lt;action&amp;gt;&lt;/code&gt;&lt;br&gt;• &lt;b&gt;status:&lt;/b&gt; Audits seal state &amp;amp; v2.2.0 health&lt;br&gt;• &lt;b&gt;seed:&lt;/b&gt; Seeds secret/hotel-database, secret/hotel-auth, secret/application&lt;br&gt;• &lt;b&gt;k8s-auth:&lt;/b&gt; Configures auth/kubernetes &amp;amp; 4 least-privilege roles&lt;br&gt;• &lt;b&gt;istio-pki:&lt;/b&gt; Generates Root/Intermediate CA &amp;amp; signs istio-system/cacerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="120" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2_srv" parent="1" value="&lt;b&gt;2. HashiCorp Vault v2.2.0 Server (namespace: vault)&lt;/b&gt;&lt;br&gt;Image: &lt;code&gt;hashicorp/vault:2.2.0&lt;/code&gt; • Port 8200&lt;br&gt;• Readiness &amp;amp; Liveness Probes: &lt;code&gt;GET /v1/sys/health&lt;/code&gt;&lt;br&gt;• Non-root execution (UID 100 / GID 1000)&lt;br&gt;• Token &amp;amp; Kubernetes ServiceAccount Authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="660" y="120" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2_eso" parent="1" value="&lt;b&gt;3. External Secrets Operator (ESO)&lt;/b&gt;&lt;br&gt;ClusterSecretStore: &lt;code&gt;vault-backend&lt;/code&gt;&lt;br&gt;ExternalSecret: &lt;code&gt;hotel-app-secrets&lt;/code&gt; (namespace: dev)&lt;br&gt;• Synchronizes Vault KV-v2 secrets into native K8s Secrets&lt;br&gt;• Zero application code coupling to Vault REST API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1260" y="120" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2_kv" parent="1" value="&lt;b&gt;KV-v2 Secrets Engine (secret/)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;secret/data/hotel-database&lt;/code&gt; (PostgreSQL 18 credentials)&lt;br&gt;• &lt;code&gt;secret/data/hotel-auth&lt;/code&gt; (JWT signing key &amp;amp; Keycloak admin)&lt;br&gt;• &lt;code&gt;secret/data/application&lt;/code&gt; (Kafka brokers &amp;amp; runtime env)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="340" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_k8s" parent="1" value="&lt;b&gt;Scoped Kubernetes Auth Roles (auth/kubernetes)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;room-service-role&lt;/code&gt; -&gt; &lt;code&gt;room-service-policy&lt;/code&gt; (TTL 1h, ns: dev)&lt;br&gt;• &lt;code&gt;stay-service-role&lt;/code&gt; -&gt; &lt;code&gt;stay-service-policy&lt;/code&gt; (TTL 1h, ns: dev)&lt;br&gt;• &lt;code&gt;billing-service-role&lt;/code&gt; -&gt; &lt;code&gt;billing-service-policy&lt;/code&gt; (TTL 1h, ns: dev)&lt;br&gt;• &lt;code&gt;notification-worker-role&lt;/code&gt; -&gt; &lt;code&gt;notification-worker-policy&lt;/code&gt; (TTL 1h, ns: dev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="660" y="340" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_pki" parent="1" value="&lt;b&gt;Vault PKI Engine for Istio Service Mesh (pki/ &amp;amp; pki_int/)&lt;/b&gt;&lt;br&gt;• Root CA: &lt;code&gt;hotel-premium.local Root CA&lt;/code&gt; (87600h)&lt;br&gt;• Intermediate CA: &lt;code&gt;hotel-premium.local Istio Intermediate CA&lt;/code&gt; (43800h)&lt;br&gt;• Provisions &lt;code&gt;ca-cert.pem&lt;/code&gt;, &lt;code&gt;ca-key.pem&lt;/code&gt;, &lt;code&gt;root-cert.pem&lt;/code&gt;, &lt;code&gt;cert-chain.pem&lt;/code&gt;&lt;br&gt;• Mounted into &lt;code&gt;istiod&lt;/code&gt; via &lt;code&gt;istio-system/cacerts&lt;/code&gt; for STRICT mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="1260" y="340" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" parent="1" value="Configures &amp;amp; Seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;" edge="1" source="p2_cli" target="p2_srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e2" parent="1" value="Syncs KV-v2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p2_srv" target="p2_eso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="p2_srv" target="p2_kv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p2_srv" target="p2_k8s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e5" parent="1" value="Signs cacerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;" edge="1" source="p2_srv" target="p2_pki">
          <mxGeometry relative="1" as="geometry" />
