      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_3_kong_istio" name="3. Kong Gateway v3.9.4 &amp; Istio 1.31.2 Mesh">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;NORTH-SOUTH API GATEWAY (KONG v3.9.4) vs. EAST-WEST SERVICE MESH (ISTIO 1.31.2)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Strict separation of concerns: Kong handles external API protection; Istio enforces workload identity, STRICT mTLS, and Canary traffic shifting&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="160" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_ns" parent="1" value="&lt;b&gt;🌐 NORTH-SOUTH TRAFFIC: Kong Gateway v3.9.4 (DB-less Declarative Mode)&lt;/b&gt;&lt;br&gt;• Public Proxy Port: &lt;code&gt;8000&lt;/code&gt; | Loopback-Only Admin &amp;amp; Status API: &lt;code&gt;127.0.0.1:8001&lt;/code&gt;&lt;br&gt;• Non-root hardened runtime with writable ephemeral prefix: &lt;code&gt;KONG_PREFIX=/tmp/kong&lt;/code&gt;&lt;br&gt;• Declarative &lt;code&gt;kong.yml&lt;/code&gt; routes: &lt;code&gt;/api/v1/rooms&lt;/code&gt;, &lt;code&gt;/api/v1/stays&lt;/code&gt;, &lt;code&gt;/api/v1/billing&lt;/code&gt;, &lt;code&gt;/api/v1/notifications&lt;/code&gt;&lt;br&gt;• Edge Plugins: Rate-Limiting (120 req/min), Request Size Limiting, Strict CORS, Correlation-ID &amp;amp; OpenTelemetry W3C Propagation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="120" width="820" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p3_ew" parent="1" value="&lt;b&gt;🔒 EAST-WEST TRAFFIC: Istio Service Mesh 1.31.2 + Kiali v2.33.0&lt;/b&gt;&lt;br&gt;• Control Plane: &lt;code&gt;istiod&lt;/code&gt; in &lt;code&gt;istio-system&lt;/code&gt; backed by Vault PKI &lt;code&gt;cacerts&lt;/code&gt;&lt;br&gt;• &lt;code&gt;PeerAuthentication&lt;/code&gt;: Enforces &lt;code&gt;mtls.mode: STRICT&lt;/code&gt; across namespace &lt;code&gt;dev&lt;/code&gt;&lt;br&gt;• &lt;code&gt;DestinationRule&lt;/code&gt;: &lt;code&gt;ISTIO_MUTUAL&lt;/code&gt; TLS + Connection Pool &amp;amp; Outlier Detection Circuit Breakers&lt;br&gt;• &lt;code&gt;AuthorizationPolicy&lt;/code&gt;: Default-deny + explicit SPIFFE allowlist for Kong Gateway and internal S2S calls&lt;br&gt;• Progressive Canary Engine: &lt;code&gt;.\platform-minikube.ps1 canary -Action weight|promote|retire&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="120" width="820" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod1" parent="1" value="&lt;b&gt;Pod: room-service + Envoy Proxy&lt;/b&gt;&lt;br&gt;SPIFFE Identity • Port 8081&lt;br&gt;Canary VirtualService (90/10 split)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="410" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod2" parent="1" value="&lt;b&gt;Pod: stay-service + Envoy Proxy&lt;/b&gt;&lt;br&gt;SPIFFE Identity • Port 8082&lt;br&gt;S2S mTLS caller to room-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="520" y="410" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod3" parent="1" value="&lt;b&gt;Pod: billing-service + Envoy Proxy&lt;/b&gt;&lt;br&gt;SPIFFE Identity • Port 8083&lt;br&gt;Folio &amp;amp; Charge API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="410" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_pod4" parent="1" value="&lt;b&gt;Pod: notification-worker + Envoy Proxy&lt;/b&gt;&lt;br&gt;SPIFFE Identity • Port 8084&lt;br&gt;KEDA Autoscaled Kafka Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="1400" y="410" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_e1" parent="1" value="North-South Ingress -&gt; East-West Mesh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="p3_ns" target="p3_ew">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e2" parent="1" value="STRICT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p3_ns" target="p3_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e3" parent="1" value="STRICT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p3_ns" target="p3_pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e4" parent="1" value="STRICT mTLS S2S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p3_pod2" target="p3_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_4_k8s_namespaces" name="4. Kubernetes &amp; Minikube 8-Namespace Topology">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;KUBERNETES v1.37.0 &amp;amp; MINIKUBE v1.39.0 — 8 STRICT NAMESPACES TOPOLOGY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;gatekeeper-system • observability • opencost • auth • data • vault • keda • dev (+ istio-system)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="200" y="25" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ns1" parent="1" value="&lt;b&gt;1. gatekeeper-system&lt;/b&gt;&lt;br&gt;OPA Gatekeeper v3.23.0&lt;br&gt;• gatekeeper-controller-manager&lt;br&gt;• gatekeeper-audit&lt;br&gt;• K8sDisallowRoot&lt;br&gt;• K8sRequiredResources&lt;br&gt;• K8sTrustedRegistries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="60" y="110" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ns2" parent="1" value="&lt;b&gt;2. observability&lt;/b&gt;&lt;br&gt;LGTM Telemetry Stack&lt;br&gt;• Grafana v13.2.3 (:3000)&lt;br&gt;• Prometheus v3.14.0 (:9090)&lt;br&gt;• Tempo v3.0.5 (:3200)&lt;br&gt;• Loki v3.7.8 (:3100)&lt;br&gt;• Alloy v1.21.0 (:3300)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="500" y="110" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ns3" parent="1" value="&lt;b&gt;3. opencost&lt;/b&gt;&lt;br&gt;FinOps Engine v2.5.32&lt;br&gt;• opencost (:9003 API)&lt;br&gt;• opencost-ui (:7000 UI)&lt;br&gt;• Live K8s Cost Allocation&lt;br&gt;• Connected to Prometheus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="940" y="110" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ns4" parent="1" value="&lt;b&gt;4. auth&lt;/b&gt;&lt;br&gt;Identity &amp;amp; Access Management&lt;br&gt;• Keycloak 26.8.1 (:8181)&lt;br&gt;• Realm: hotel-realm&lt;br&gt;• OIDC / PKCE / RBAC Roles&lt;br&gt;• Automated Bootstrap Script" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="1380" y="110" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ns5" parent="1" value="&lt;b&gt;5. data&lt;/b&gt;&lt;br&gt;Stateful Persistence &amp;amp; Exporters&lt;br&gt;• PostgreSQL 18 (:5432) + GiST&lt;br&gt;• Redis 8.8.1 (:6379)&lt;br&gt;• Apache Kafka 8.3.2 KRaft (:9092)&lt;br&gt;• postgres-exporter v0.20.1 (:9187)&lt;br&gt;• redis-exporter v1.94.0 (:9121)&lt;br&gt;• kafka-exporter v1.9.0 (:9308)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="60" y="340" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ns6" parent="1" value="&lt;b&gt;6. vault&lt;/b&gt;&lt;br&gt;Secrets &amp;amp; PKI Engine&lt;br&gt;• HashiCorp Vault v2.2.0 (:8200)&lt;br&gt;• KV-v2 Secrets Store&lt;br&gt;• Kubernetes Auth Engine&lt;br&gt;• Root &amp;amp; Intermediate PKI CA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="500" y="340" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ns7" parent="1" value="&lt;b&gt;7. keda&lt;/b&gt;&lt;br&gt;Event-Driven Autoscaling v2.21.0&lt;br&gt;• keda-operator&lt;br&gt;• keda-operator-metrics-apiserver&lt;br&gt;• keda-admission-webhooks&lt;br&gt;• Scales notification-worker (1..8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="940" y="340" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ns8" parent="1" value="&lt;b&gt;8. dev (Helm 4.3.1 Release: hotel-premium)&lt;/b&gt;&lt;br&gt;PodSecurity: enforce=privileged (Istio init) | warn/audit=baseline&lt;br&gt;• kong-gateway v3.9.4 (:8000 / :8001)&lt;br&gt;• room-service (:8081) • stay-service (:8082)&lt;br&gt;• billing-service (:8083) • notification-worker (:8084)&lt;br&gt;• hotel-frontend (:5173 / :80) • HPA &amp;amp; KEDA ScaledObject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1380" y="340" width="440" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_5_saga_seq" name="5. E2E Guest Journey &amp; Booking Saga Sequence">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;END-TO-END HOTEL GUEST JOURNEY &amp;amp; DISTRIBUTED BOOKING SAGA SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;React 19 SPA ➔ Kong v3.9.4 ➔ Stay Service ➔ Redis Idempotency ➔ Room Service ➔ PostgreSQL 18 GiST + Outbox ➔ Kafka 8.3.2 ➔ Notification Worker&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="140" y="25" width="1640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_s1" parent="1" value="&lt;b&gt;1. Guest Catalog Query:&lt;/b&gt; React 19 SPA requests &lt;code&gt;GET /api/v1/rooms&lt;/code&gt; via Kong Gateway (:8000) -&gt; &lt;code&gt;room-service&lt;/code&gt; serves from Redis 8.8.1 &lt;code&gt;singleflight&lt;/code&gt; cache (&lt;code&gt;rooms:all&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="110" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s_s2" parent="1" value="&lt;b&gt;2. Idempotent Booking Request:&lt;/b&gt; Guest submits &lt;code&gt;POST /api/v1/stays/saga-booking&lt;/code&gt; with &lt;code&gt;Idempotency-Key&lt;/code&gt; and W3C &lt;code&gt;traceparent&lt;/code&gt; header." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="180" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s_s3" parent="1" value="&lt;b&gt;3. Distributed Idempotency Lock (Redis 8.8.1):&lt;/b&gt; &lt;code&gt;stay-service&lt;/code&gt; acquires atomic &lt;code&gt;SETNX idempotency:lock:POST:/api/v1/stays/saga-booking:&amp;lt;key&amp;gt;&lt;/code&gt; (30s TTL) and checks cached response (24h TTL)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="250" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s_s4" parent="1" value="&lt;b&gt;4. Saga Step 1 (Room Reservation):&lt;/b&gt; &lt;code&gt;BookingSagaOrchestrator&lt;/code&gt; verifies availability and transitions room status via &lt;code&gt;room-service&lt;/code&gt; over Istio STRICT mTLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="320" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s_s5" parent="1" value="&lt;b&gt;5. Saga Step 2 (Atomic DB + GiST + Outbox):&lt;/b&gt; PostgreSQL 18 validates &lt;code&gt;stays_room_period_exclusion&lt;/code&gt; (&lt;code&gt;btree_gist&lt;/code&gt; zero double-booking) and commits &lt;code&gt;stays&lt;/code&gt; + &lt;code&gt;stay_outbox_events&lt;/code&gt; in one ACID transaction. (If Step 2 fails, Saga executes compensating rollback freeing the room)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="390" width="1600" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s_s6" parent="1" value="&lt;b&gt;6. Asynchronous Outbox Dispatch:&lt;/b&gt; Background &lt;code&gt;OutboxPublisher&lt;/code&gt; polls &lt;code&gt;stay_outbox_events&lt;/code&gt; with &lt;code&gt;SELECT ... FOR UPDATE SKIP LOCKED&lt;/code&gt; and publishes LZ4 event to Kafka 8.3.2 topic &lt;code&gt;hotel.stays.lifecycle.v1&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="470" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s_s7" parent="1" value="&lt;b&gt;7. Deduplicated Notification &amp;amp; DLQ Safety:&lt;/b&gt; &lt;code&gt;notification-worker&lt;/code&gt; checks &lt;code&gt;SETNX notif:dedup:&amp;lt;event_id&amp;gt;&lt;/code&gt; in Redis, dispatches VIP welcome notification, or routes poison-pill messages after 3 retries to &lt;code&gt;hotel.stays.lifecycle.v1.DLQ&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="120" y="540" width="1600" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_6_outbox_kafka_keda" name="6. Outbox, Kafka 8.3.2 KRaft &amp; KEDA v2.21.0">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;TRANSACTIONAL OUTBOX, APACHE KAFKA 8.3.2 KRAFT &amp;amp; KEDA v2.21.0 AUTOSCALING&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Zero dual-write data loss during broker outages, LZ4 high-throughput streaming, Redis deduplication, and lag-driven autoscaling&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="160" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6_outbox" parent="1" value="&lt;b&gt;PostgreSQL 18 Transactional Outbox&lt;/b&gt;&lt;br&gt;• Table: &lt;code&gt;stay_outbox_events&lt;/code&gt;&lt;br&gt;• Atomic commit with &lt;code&gt;stays&lt;/code&gt; table&lt;br&gt;• Polled via &lt;code&gt;FOR UPDATE SKIP LOCKED&lt;/code&gt;&lt;br&gt;• Exponential backoff retry on broker outage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="140" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6_kafka" parent="1" value="&lt;b&gt;Apache Kafka 8.3.2 (KRaft Mode)&lt;/b&gt;&lt;br&gt;• Image: &lt;code&gt;confluentinc/cp-kafka:8.3.2&lt;/code&gt;&lt;br&gt;• Compression: &lt;code&gt;LZ4&lt;/code&gt;&lt;br&gt;• Primary Topic: &lt;code&gt;hotel.stays.lifecycle.v1&lt;/code&gt; (3 partitions)&lt;br&gt;• Dead-Letter Topic: &lt;code&gt;hotel.stays.lifecycle.v1.DLQ&lt;/code&gt; (7d retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="660" y="140" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6_keda" parent="1" value="&lt;b&gt;KEDA v2.21.0 ScaledObject (notification-worker-scaler)&lt;/b&gt;&lt;br&gt;• Target: &lt;code&gt;deployment/notification-worker&lt;/code&gt;&lt;br&gt;• Min Replicas: &lt;code&gt;1&lt;/code&gt; | Max Replicas: &lt;code&gt;8&lt;/code&gt; | Fallback: &lt;code&gt;2&lt;/code&gt; replicas&lt;br&gt;• Trigger 1: Kafka Consumer Lag &amp;gt; &lt;code&gt;10&lt;/code&gt; (&lt;code&gt;hotel-notification-cg&lt;/code&gt;)&lt;br&gt;• Trigger 2: CPU Utilization &amp;gt; &lt;code&gt;75%&lt;/code&gt;&lt;br&gt;• Stabilization Window: ScaleUp &lt;code&gt;30s&lt;/code&gt; / ScaleDown &lt;code&gt;180s&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="1280" y="140" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6_e1" parent="1" value="Publish LZ4 Batch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;" edge="1" source="p6_outbox" target="p6_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_e2" parent="1" value="Consumer Lag Metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="p6_kafka" target="p6_keda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_7_observability_finops" name="7. LGTM Observability &amp; FinOps Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;UNIFIED LGTM OBSERVABILITY MESH &amp;amp; OPENCOST FINOPS ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Grafana v13.2.3 • Tempo v3.0.5 • Loki v3.7.8 • Prometheus v3.14.0 • Alloy v1.21.0 • OpenCost v2.5.32&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="180" y="30" width="1560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7_alloy" parent="1" value="&lt;b&gt;Grafana Alloy v1.21.0 (:3300)&lt;/b&gt;&lt;br&gt;• Unified OTLP Receiver (:4317 gRPC / :4318 HTTP)&lt;br&gt;• &lt;code&gt;otelcol.processor.batch&lt;/code&gt; pipeline&lt;br&gt;• Forwards traces to Tempo, structured JSON logs to Loki, and span metrics to Prometheus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="130" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p7_pillars" parent="1" value="&lt;b&gt;Three Telemetry Pillars + Exporters&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tempo v3.0.5 (:3200):&lt;/b&gt; Distributed traces + &lt;code&gt;metrics_generator&lt;/code&gt; (service-graphs &amp;amp; span-metrics)&lt;br&gt;• &lt;b&gt;Loki v3.7.8 (:3100):&lt;/b&gt; TSDB v13 + &lt;code&gt;allow_structured_metadata: true&lt;/code&gt; + 7d compactor&lt;br&gt;• &lt;b&gt;Prometheus v3.14.0 (:9090):&lt;/b&gt; 10 SRE Alert Rules + Postgres (v0.20.1), Redis (v1.94.0), Kafka (v1.9.0) exporters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="660" y="130" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p7_graf" parent="1" value="&lt;b&gt;Grafana v13.2.3 (:3000) &amp;amp; OpenCost v2.5.32 (:7000)&lt;/b&gt;&lt;br&gt;• Feature Toggles: &lt;code&gt;traceqlEditor,correlations,flameGraph&lt;/code&gt;&lt;br&gt;• Bidirectional Trace ➔ Log (&lt;code&gt;trace_id&lt;/code&gt;) &amp;amp; Trace ➔ Metric correlation&lt;br&gt;• OpenCost live namespace allocation + &lt;code&gt;finops-rightsize&lt;/code&gt; 7-day peak recommender ($348.50/mo local savings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1280" y="130" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p7_e1" parent="1" value="OTLP / Remote Write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="p7_alloy" target="p7_pillars">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7_e2" parent="1" value="Datasources &amp;amp; Alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="p7_pillars" target="p7_graf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_8_devsecops_cicd" name="8. 6-Gate DevSecOps &amp; Helm 4.3.1 Pipeline">
