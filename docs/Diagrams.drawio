  <diagram id="page_9_cloudflare_tunnels" name="9. Cloudflare Quick Tunnels &amp; Network Supervisor">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;CLOUDFLARE ANYCAST QUICK TUNNELS &amp;amp; SELF-HEALING PORT-FORWARD ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Automated local port-forwarding (supervise-tunnels.py) + Public HTTPS Edge Tunnels (manage-cloudflare-tunnels.ps1)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="160" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9_local" parent="1" value="&lt;b&gt;1. Self-Healing Localhost Supervisor (scripts/supervise-tunnels.py)&lt;/b&gt;&lt;br&gt;• Automatically started by &lt;code&gt;.\platform-minikube.ps1 up&lt;/code&gt; and &lt;code&gt;start&lt;/code&gt;&lt;br&gt;• Continuously monitors and auto-restarts &lt;code&gt;kubectl port-forward&lt;/code&gt; sockets:&lt;br&gt;  Frontend (:5173), Kong (:8000/:8001/:8002), Room (:8081), Stay (:8082), Billing (:8083),&lt;br&gt;  Notif (:8084), Keycloak (:8181), Vault (:8200), Grafana (:3000), Prometheus (:9090), Alloy (:3300), OpenCost (:7000), Kiali (:20001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="130" width="820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p9_cf" parent="1" value="&lt;b&gt;2. Cloudflare Anycast Quick Tunnels (scripts/manage-cloudflare-tunnels.ps1)&lt;/b&gt;&lt;br&gt;• Command: &lt;code&gt;.\platform-minikube.ps1 cloudflare -Action start|status|restart|stop&lt;/code&gt;&lt;br&gt;• Spawns HTTP/2 &lt;code&gt;cloudflared&lt;/code&gt; tunnels for Frontend (:5173), Kong Gateway (:8000), and Keycloak (:8181)&lt;br&gt;• Persists active public &lt;code&gt;https://*.trycloudflare.com&lt;/code&gt; URLs in &lt;code&gt;scripts/.cloudflare-tunnels.json&lt;/code&gt;&lt;br&gt;• Automatically consumed by &lt;code&gt;Get-DevSecOpsTargetUrl&lt;/code&gt; for external Newman, k6 &amp;amp; OWASP ZAP scans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="130" width="840" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p9_e1" parent="1" value="Exposes Local Ports to Cloudflare Edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="p9_local" target="p9_cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_10_aws_cloud" name="10. AWS Production Cloud Architecture (EKS)">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p10_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;AWS PRODUCTION CLOUD ARCHITECTURE — AMAZON EKS, RDS POSTGRESQL 18, ELASTICACHE &amp;amp; MSK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Terraform v1.16.6 IaC • Private VPC Endpoints • IMDSv2 Enforced • Customer-Managed KMS • Trivy AWS-0040/0041/0104 Clean&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="140" y="30" width="1640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p10_vpc" parent="1" value="&lt;b&gt;AWS Multi-AZ VPC (10.0.0.0/16) — Hardened Network Perimeter&lt;/b&gt;&lt;br&gt;• EKS API Server: &lt;code&gt;endpoint_public_access = false&lt;/code&gt;, &lt;code&gt;endpoint_private_access = true&lt;/code&gt;, &lt;code&gt;public_access_cidrs = [var.vpc_cidr]&lt;/code&gt;&lt;br&gt;• EKS Worker Nodes Security Group: Egress strictly scoped to &lt;code&gt;[var.vpc_cidr]&lt;/code&gt; (Zero unrestricted 0.0.0.0/0 egress)&lt;br&gt;• EC2 Launch Template: &lt;code&gt;http_tokens = required&lt;/code&gt; (IMDSv2 mandatory) + KMS-encrypted GP3 EBS volumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="130" width="820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p10_data" parent="1" value="&lt;b&gt;Managed AWS Data &amp;amp; Security Tier (Private Subnets)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Amazon RDS PostgreSQL 18:&lt;/b&gt; Multi-AZ, KMS encrypted at rest, automated backups &amp;amp; PitR&lt;br&gt;• &lt;b&gt;Amazon ElastiCache Redis 8.8.1:&lt;/b&gt; Multi-AZ Replication Group, transit &amp;amp; at-rest encryption&lt;br&gt;• &lt;b&gt;Amazon MSK (Apache Kafka):&lt;/b&gt; 3-AZ broker cluster with TLS encryption&lt;br&gt;• &lt;b&gt;AWS KMS &amp;amp; IAM OIDC:&lt;/b&gt; Automatic key rotation + Keyless GitHub Actions OIDC deployer role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="130" width="840" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_11_bcdr_chaos" name="11. BCDR, PitR &amp; Chaos Engineering Drills">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p11_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;BUSINESS CONTINUITY, DISASTER RECOVERY (BCDR) &amp;amp; CHAOS ENGINEERING DRILLS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Automated RPO/RTO Verification • Kafka Broker Outage Outbox Drill • Concurrent GiST + Redis Idempotency Chaos • Edge Anti-DDoS Probe&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="140" y="30" width="1640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p11_bcdr" parent="1" value="&lt;b&gt;1. PostgreSQL 18 Backup &amp;amp; PitR Drill (bcdr)&lt;/b&gt;&lt;br&gt;Command: &lt;code&gt;.\platform-minikube.ps1 bcdr&lt;/code&gt;&lt;br&gt;• Executes &lt;code&gt;pg_dump&lt;/code&gt; snapshot &amp;amp; checksum verification&lt;br&gt;• Validates Recovery Time Objective (RTO &amp;lt; 5m) &amp;amp; RPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p11_outbox" parent="1" value="&lt;b&gt;2. Kafka Outage Resilience Drill (chaos-drills)&lt;/b&gt;&lt;br&gt;Command: &lt;code&gt;.\platform-minikube.ps1 chaos-drills&lt;/code&gt;&lt;br&gt;• Pauses Kafka 8.3.2 broker, creates VIP reservation&lt;br&gt;• Verifies 0% user downtime &amp;amp; automatic Outbox drain on recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="520" y="140" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p11_chaos" parent="1" value="&lt;b&gt;3. Concurrent GiST &amp;amp; Idempotency Chaos (chaos)&lt;/b&gt;&lt;br&gt;Command: &lt;code&gt;.\platform-minikube.ps1 chaos&lt;/code&gt;&lt;br&gt;• Fires concurrent overlapping booking bursts with shared &lt;code&gt;Idempotency-Key&lt;/code&gt;&lt;br&gt;• Proves 0 double-bookings &amp;amp; 0 HTTP 500 errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p11_ddos" parent="1" value="&lt;b&gt;4. Edge Rate-Limiting &amp;amp; Anti-DDoS Probe (ddos)&lt;/b&gt;&lt;br&gt;Command: &lt;code&gt;.\platform-minikube.ps1 ddos&lt;/code&gt;&lt;br&gt;• Floods Kong Gateway (:8000) with multi-worker burst traffic&lt;br&gt;• Verifies HTTP 429 throttling &amp;amp; p50/p95 latency stability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="1420" y="140" width="400" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_12_orchestrator" name="12. Unified Orchestrator (platform-minikube.ps1)">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p12_title" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;UNIFIED PLATFORM ORCHESTRATOR — platform-minikube.ps1 COMMAND MATRIX&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;9-Stage Full Bootstrap (up) • 6-Stage Fast Resume (&amp;lt;30s start) • 36 Self-Contained DevSecOps, Cloud, Vault &amp;amp; SRE Commands&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="160" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p12_up" parent="1" value="&lt;b&gt;9-Stage Full Bootstrap (&lt;code&gt;.\platform-minikube.ps1 up [-Build]&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;[1/9] 6-Gate Shift-Left Security Scan (Gitleaks, Semgrep, TFLint, Trivy, Conftest 205/205, Cosign)&lt;br&gt;[2/9] Minikube v1.39.0 / K8s v1.37.0 Startup (Smart Docker RAM Auto-Adjust + metrics-server wait)&lt;br&gt;[3/9] 8 Strict Namespaces &amp;amp; PodSecurity Standards&lt;br&gt;[4/9] OPA Gatekeeper v3.23.0 ConstraintTemplates &amp;amp; Security Constraints&lt;br&gt;[5/9] Istio 1.31.2 Service Mesh (STRICT mTLS), Kiali v2.33.0 &amp;amp; Kong Gateway v3.9.4&lt;br&gt;[6/9] Keycloak 26.8.1, LGTM Observability, HashiCorp Vault v2.2.0 (KV + K8s Auth) &amp;amp; OpenCost v2.5.32&lt;br&gt;[7/9] HorizontalPodAutoscalers (HPA) &amp;amp; KEDA v2.21.0 Event-Driven Autoscaling&lt;br&gt;[8/9] PostgreSQL 18 Migrations (000001..000004), Kafka 8.3.2 Topics &amp;amp; Helm 4.3.1 Server-Side Apply&lt;br&gt;[9/9] Self-Healing Localhost Tunnels, 9/9 HTTP Smoke Verification &amp;amp; FinOps Cost Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="120" width="840" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p12_start" parent="1" value="&lt;b&gt;6-Stage Fast Resume &amp;lt;30s (&lt;code&gt;.\platform-minikube.ps1 start&lt;/code&gt;) &amp;amp; Operational Commands&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Fast Resume:&lt;/b&gt; [1/6] Core CLIs ➔ [2/6] Cosign Provenance ➔ [3/6] Minikube Resume ➔ [4/6] Wait Critical Pods ➔ [5/6] Reconcile Vault &amp;amp; Istio ➔ [6/6] Connect Tunnels &amp;amp; Smoke Test&lt;br&gt;• &lt;b&gt;Cloudflare Edge:&lt;/b&gt; &lt;code&gt;cloudflare -Action start|status|restart|stop&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Vault Zero-Trust:&lt;/b&gt; &lt;code&gt;vault -VaultAction status|seed|k8s-auth|istio-pki&lt;/code&gt;&lt;br&gt;• &lt;b&gt;SRE &amp;amp; Testing:&lt;/b&gt; &lt;code&gt;test&lt;/code&gt;, &lt;code&gt;smoke-test&lt;/code&gt;, &lt;code&gt;simulate&lt;/code&gt;, &lt;code&gt;contract&lt;/code&gt;, &lt;code&gt;performance&lt;/code&gt;, &lt;code&gt;dast&lt;/code&gt;, &lt;code&gt;ddos&lt;/code&gt;, &lt;code&gt;chaos&lt;/code&gt;, &lt;code&gt;chaos-drills&lt;/code&gt;, &lt;code&gt;diagnose&lt;/code&gt;, &lt;code&gt;bcdr&lt;/code&gt;&lt;br&gt;• &lt;b&gt;FinOps &amp;amp; IaC:&lt;/b&gt; &lt;code&gt;cost&lt;/code&gt;, &lt;code&gt;finops-rightsize&lt;/code&gt;, &lt;code&gt;plan&lt;/code&gt;, &lt;code&gt;apply&lt;/code&gt;, &lt;code&gt;graph&lt;/code&gt;, &lt;code&gt;diagrams&lt;/code&gt;, &lt;code&gt;set-tag&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="120" width="840" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
